parameters:
  level: 4
  treatPhpDocTypesAsCertain: false
  paths:
    - src
  ignoreErrors:
    # SilverStripe config properties are read via Config::inst()->get() at runtime
    # PHPStan doesn't detect this indirect usage pattern
    -
      identifier: property.onlyWritten

    # The same false positive on a config property, under a second identifier: PHPStan 2.x
    # reports a property that is never read as "property.onlyWritten" (the entry above) and a
    # property whose declared type is wider than anything assigned to it as
    # "property.unusedType" (this one), and both identifiers appear in a single run of
    # phpstan 2.3.1 over src/, so the entry above cannot cover it.
    # Scoped to the one config property it is about instead of suppressing the check.
    -
      identifier: property.unusedType
      message: '#UserController::\$password_description \(string\|null\) is never assigned string#'

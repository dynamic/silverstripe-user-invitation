parameters:
  level: 4
  treatPhpDocTypesAsCertain: false
  paths:
    - src
  ignoreErrors:
    # SilverStripe config properties are read via Config::inst()->get() at runtime
    # PHPStan doesn't detect this indirect usage pattern
    -
      identifier: property.onlyWritten

    # Same class of false positive, other identifier: PHPStan 2.x split the
    # "property.onlyWritten" check in two and renamed the "declared type is never
    # assigned" variant to "property.unusedType", which the entry above does not cover.
    # Scoped to the one config property it is about instead of suppressing the check.
    -
      identifier: property.unusedType
      message: '#UserController::\$password_description \(string\|null\) is never assigned string#'
